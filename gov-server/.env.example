# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=gov_report
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_SSL=false

# Alternatively, configure via DATABASE_URL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gov_report

